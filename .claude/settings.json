{
  "permissions": {
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/tools/agent-hooks/pre-push-analyze.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/tools/agent-hooks/pre-commit-lockfile.sh"
          }
        ]
      }
    ]
  }
}
